[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[commit]
	gpgsign = true
[gpg]
	program = gpg
[safe]
	directory = *

# Machine-specific personal identity (kept out of dotfiles)
[include]
	path = config.local
