# ==========================================
# MAKO NOTIFICATION DAEMON CONFIG
# ==========================================

# --- Global Appearance ---
font=JetBrainsMono Nerd Font 11
width=360
height=100
margin=8
padding=12,16
border-size=2
border-radius=0
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/Papirus:/home/faulter/.local/share/icons/hicolor:/usr/share/icons/hicolor
icon-location=left
format=<b>%s</b>\n<span size="10pt" alpha="70%%">%b</span>

# --- Global Behavior ---
layer=overlay
anchor=top-right
max-visible=4
max-history=50
sort=-time
group-by=app-name
ignore-timeout=0
default-timeout=5000
on-button-left=invoke-default-action
on-button-middle=exec makoctl menu -n "$id" -- /home/faulter/.local/bin/mako-menu
on-button-right=dismiss

# --- Colors: generated by theme-daemon (global colours and the urgency borders), before any [section] of this file ---
include=~/.cache/theme/colors-mako

# ── Urgency Overrides ──

[urgency=low]
default-timeout=3000

[urgency=high]
default-timeout=0
border-size=3

# ── Do Not Disturb ──

[mode=do-not-disturb]
invisible=1

# A failed service or anything critical still shows while do-not-disturb is on (tested on a private bus: the more specific section applies)
[mode=do-not-disturb urgency=critical]
invisible=0

# ── Per-App Criteria ──

# Volume / Brightness OSD — compact, no icon
[app-name=sysnotify]
width=260
height=60
padding=8,12
icons=0
format=<b>%s</b>  %b
default-timeout=1500

# Media — album art prominence
[app-name=media]
width=400
height=100
max-icon-size=80
padding=14,16
format=<b><span size="12pt">%s</span></b>\n<span size="10pt" alpha="70%%">%b</span>

# System panel — history readout
[app-name=syspanel]
height=450
width=380
default-timeout=8000
format=<b>%s</b>\n<span size="9pt" alpha="80%%">%b</span>

# Screenshots / Screen recording
[app-name=screenrecord]
default-timeout=3000

# Power state changes
[app-name=power-daemon]
default-timeout=4000

# Visual indicator for notifications with interactive actions
[actionable]
default-timeout=25000

# Screenshots custom renderer
[app-name=screenshot]
default-timeout=7000
