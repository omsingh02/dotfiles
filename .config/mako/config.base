# ==========================================
# MAKO NOTIFICATION DAEMON CONFIG
# ==========================================

# --- Appearance ---
font=JetBrainsMono Nerd Font 12
width=350
height=150
margin=10
padding=10
border-size=3
border-radius=0
max-icon-size=128
format=<b>%s</b>\n%b
icon-location=left

# --- Behavior ---
layer=overlay
anchor=top-right
max-visible=5
max-history=10
ignore-timeout=1

# --- Timeouts (in milliseconds) ---
default-timeout=5000

# --- Colors (injected by wallust at build time, placed here in global scope) ---
# WALLUST_COLORS_PLACEHOLDER

# Low priority notifications vanish quickly
[urgency=low]
default-timeout=2000

# High priority alerts stay until clicked
[urgency=high]
default-timeout=0
border-size=3

# --- Media Notifications ---
[app-name=mediactl]
font=sans-serif 11
width=440
height=110
max-icon-size=96
padding=20
margin=15,15,15,15
border-size=3
format=<b><span size="13pt">%s</span></b>\n<span size="11pt" alpha="70%%">%b</span>

