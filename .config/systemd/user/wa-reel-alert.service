[Unit]
Description=WhatsApp Reel Live Notifier & PiP Player (v2)
After=wa-notify-server.service graphical-session.target
Wants=wa-notify-server.service

[Service]
Type=simple
ExecStart=%h/.local/bin/wa-reel-alert
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
