#!/usr/bin/env bash
# Author: Om Singh
# Mount/unmount removable drives using udisksctl + fuzzel
# Usage: drivemount mount | unmount

MENU="fuzzel -d -p"

mount_drive() {
    local drives
    drives="$(lsblk -rpo "name,type,size,mountpoint" | awk '$2=="part" && $4=="" {print $1, $3}')"
    [ -z "$drives" ] && { notify-send "Drive Mount" "No unmounted drives found"; exit 0; }

    local choice
    choice="$(echo "$drives" | $MENU 'Mount: ')" || exit 0
    local dev
    dev="$(echo "$choice" | awk '{print $1}')"

    udisksctl mount -b "$dev" 2>&1 && \
        notify-send "Drive Mounted" "$dev" || \
        notify-send "Mount Failed" "$dev"
}

unmount_drive() {
    local drives
    drives="$(lsblk -rpo "name,type,size,mountpoint" | awk '$2=="part" && $4!="" && $4!="/" && $4!~/\/boot/ && $4!~/\/home/ {print $1, $4}')"
    [ -z "$drives" ] && { notify-send "Drive Unmount" "No removable drives mounted"; exit 0; }

    local choice
    choice="$(echo "$drives" | $MENU 'Unmount: ')" || exit 0
    local dev
    dev="$(echo "$choice" | awk '{print $1}')"

    udisksctl unmount -b "$dev" 2>&1 && \
        udisksctl power-off -b "$dev" 2>/dev/null
    notify-send "Drive Unmounted" "$dev"
}

case "$1" in
    mount)   mount_drive ;;
    unmount) unmount_drive ;;
    *)
        echo "Usage: drivemount {mount|unmount}"
        exit 1
        ;;
esac
