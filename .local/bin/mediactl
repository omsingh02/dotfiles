#!/usr/bin/env bash
# Author: Om Singh
# Media control with notifications and album art
# Uses playerctl for all media control

NOTIFY_TAG="mediactl"
COVER_DIR="$HOME/.cache/mpd/covers"
STATE_DIR="${XDG_RUNTIME_DIR:-/tmp/user-$(id -u)}"
mkdir -p "$STATE_DIR"
WAYBAR_STATE="$STATE_DIR/waybar-media-json"
WAYBAR_INTERP="$STATE_DIR/waybar-media-interp"

# Ignore non-playback MPRIS services (Shazam audio recognition and playerctld proxy)
playerctl() {
    command playerctl -i Shazam,playerctld "$@"
}

# --- Quick Waybar state refresh ---
# Reads the interpolation cache and regenerates the state file with current
# status/position. This runs after toggle/seek/stop to give Waybar instant
# feedback without waiting for wall-daemon's metadata event.
_quick_update_waybar() {
    local interp_data
    interp_data=$(cat "$WAYBAR_INTERP" 2>/dev/null) || return 0
    IFS='|' read -r _s _title _artist _album _dur _pos _epoch _accent <<< "$interp_data"

    [[ -z "$_title" ]] && return 0

    # Get fresh status and position from playerctl
    local fresh
    fresh=$(playerctl metadata --format '{{status}}|{{mpris:length}}|{{position}}' 2>/dev/null) || return 0
    IFS='|' read -r new_status new_dur new_pos <<< "$fresh"
    new_pos="${new_pos%.*}"
    new_pos="${new_pos:-0}"
    new_dur="${new_dur:-$_dur}"

    # Update the interpolation file for the position updater
    local new_epoch
    new_epoch=$(date +%s)
    printf '%s|%s|%s|%s|%s|%s|%s|%s\n' \
        "$new_status" "$_title" "$_artist" "$_album" \
        "$new_dur" "$new_pos" "$new_epoch" "$_accent" \
        > "$WAYBAR_INTERP"

    # Inline the Waybar JSON generation (minimal subset)
    [[ -z "$_artist" ]] && _artist="Unknown Artist"
    [[ -z "$_album" ]] && _album="Unknown Album"

    local display_raw="$_title — $_artist"
    local max_len=30
    if [[ ${#display_raw} -gt $((max_len - 2)) ]]; then
        local truncated="${display_raw:0:$((max_len - 2))}"
        [[ "$truncated" == *" "* ]] && display_raw="${truncated% *}" || display_raw="$truncated"
        display_raw=$(echo "$display_raw" | sed 's/[,;-]*$//;s/[[:space:]]*$//')
    fi

    # Pango-escape
    local e_display="${display_raw//&/&amp;}"
    e_display="${e_display//</&lt;}"
    e_display="${e_display//>/&gt;}"
    local e_title="${_title//&/&amp;}"; e_title="${e_title//</&lt;}"; e_title="${e_title//>/&gt;}"
    local e_artist="${_artist//&/&amp;}"; e_artist="${e_artist//</&lt;}"; e_artist="${e_artist//>/&gt;}"
    local e_album="${_album//&/&amp;}"; e_album="${e_album//</&lt;}"; e_album="${e_album//>/&gt;}"

    local pct=0 progress_str=""
    local nl=$'\n'
    if [[ "${new_dur:-0}" -gt 0 ]] 2>/dev/null; then
        pct=$(( new_pos * 100 / new_dur ))
        [[ "$pct" -lt 0 || "$pct" -gt 100 ]] && pct=0
        [[ "$pct" -gt 0 ]] && progress_str="${nl}<span size='10000' color='${_accent}'>Progress: ${pct}%</span>"
    fi

    local icon="󰎆"
    [[ "$new_status" = "Paused" ]] && icon="󰏥"

    local text
    if [[ "$pct" -gt 0 ]]; then
        local len=${#e_display}
        local pc=$(( len * pct / 100 ))
        if [[ "$pc" -gt 0 ]]; then
            text="$icon <span bgalpha='30%' background='${_accent}'>${e_display:0:$pc}</span>${e_display:$pc}"
        else
            text="$icon $e_display"
        fi
    else
        text="$icon $e_display"
    fi

    local tooltip="<span size='12000' weight='bold'>${e_title}</span>${nl}<span color='#cccccc'>${e_artist}</span>${nl}<span size='10000' color='#999999'><i>${e_album}</i></span>${progress_str}"

    # JSON-escape
    local te="${text//\\/\\\\}"; te="${te//\"/\\\"}"; te="${te//$nl/\\n}"
    local tte="${tooltip//\\/\\\\}"; tte="${tte//\"/\\\"}"; tte="${tte//$nl/\\n}"

    printf '{"text":"%s","class":"%s","tooltip":"%s","percentage":%d}\n' \
        "$te" "${new_status,,}" "$tte" "${pct:-0}" > "${WAYBAR_STATE}.tmp.$$"
    mv -f "${WAYBAR_STATE}.tmp.$$" "$WAYBAR_STATE"
}

# Extract album art from current track, cache it
get_cover() {
    local data art_url url album
    if [[ -n "$PLAYER_ART_URL" ]]; then
        art_url="$PLAYER_ART_URL"
        url="$PLAYER_URL"
        album="$PLAYER_ALBUM"
    else
        data=$(playerctl metadata --format '{{mpris:artUrl}}|{{xesam:url}}|{{album}}' 2>/dev/null)
        [ -z "$data" ] && return 1
        IFS='|' read -r art_url url album <<< "$data"
    fi

    if [[ "$art_url" == file://* ]]; then
        echo "${art_url#file://}"
        return 0
    fi

    # Fallback to ffmpeg extraction if we have a file path
    local file
    if [[ "$url" == file://* ]]; then
        file="${url#file://}"
        file="$(echo -e "${file//%/\\x}")"
        if [ -f "$file" ]; then
            [ -z "$album" ] && album="unknown"
            local artist="${PLAYER_ARTIST:-$(playerctl metadata --format '{{artist}}' 2>/dev/null)}"
            [ -z "$artist" ] && artist="unknown"
            local cache_name="$(echo "$artist - $album" | base64 | tr '/' '_').png"
            local cover="$COVER_DIR/$cache_name"

            if [ -f "$cover" ]; then
                echo "$cover"
                return 0
            fi

            mkdir -p "$COVER_DIR"
            if ffmpeg -y -i "$file" -an -vf scale=128:128 "$cover" &>/dev/null; then
                echo "$cover"
                return 0
            fi
        fi
    fi

    return 1
}

get_song_display() {
    local data title artist url file
    if [[ -n "$PLAYER_TITLE" ]]; then
        title="$PLAYER_TITLE"
        artist="$PLAYER_ARTIST"
        url="$PLAYER_URL"
    else
        data=$(playerctl metadata --format '{{title}}|{{artist}}|{{xesam:url}}' 2>/dev/null)
        [ -z "$data" ] && { echo "Unknown"; echo ""; return; }
        IFS='|' read -r title artist url <<< "$data"
    fi

    if [ -z "$title" ]; then
        if [ -n "$url" ]; then
            file="${url#file://}"
            title="$(basename "$file")"
            title="$(echo -e "${title//%/\\x}")"
        else
            title="Unknown"
        fi
    fi

    if [ -n "$artist" ] && [ "$artist" != "Unknown Artist" ]; then
        echo "${title}"
        echo "${artist}"
    elif [ -n "$title" ]; then
        echo "${title}"
        echo ""
    else
        echo "Unknown"
        echo ""
    fi
}

send_notification() {
    local raw_display="$1"
    local title
    local artist
    # Read the two lines from raw_display safely
    title="$(echo "$raw_display" | head -n 1)"
    artist="$(echo "$raw_display" | tail -n +2)"

    local icon
    icon="$(get_cover 2>/dev/null)" || icon="audio-x-generic"

    # Export DBUS session so Wayland notification daemons always catch it
    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"

    notify-send -a "mediactl" \
        -h string:x-canonical-private-synchronous:"$NOTIFY_TAG" \
        -i "$icon" \
        "$title" "$artist"
    _quick_update_waybar
    pkill -RTMIN+11 waybar || true
}

do_toggle() {
    playerctl play-pause 2>/dev/null
    sleep 0.2
    local status="$(playerctl status 2>/dev/null)"
    case "$status" in
        Playing) send_notification "$(get_song_display)" ;;
        Paused)  send_notification "$(get_song_display)" ;;
        *) notify-send -a "mediactl" -h string:x-canonical-private-synchronous:"$NOTIFY_TAG" -i audio-x-generic "Playback" "Stopped"; _quick_update_waybar; pkill -RTMIN+11 waybar || true ;;
    esac
}

do_next() {
    playerctl next 2>/dev/null
}

do_prev() {
    playerctl previous 2>/dev/null
}

do_stop() {
    playerctl stop 2>/dev/null
    notify-send -a "mediactl" -h string:x-canonical-private-synchronous:"$NOTIFY_TAG" \
        -i audio-x-generic "Playback" "Stopped"
    rm -f "$WAYBAR_STATE" "$WAYBAR_INTERP" 2>/dev/null || true
    pkill -RTMIN+11 waybar || true
}

do_seek() {
    local amount="$1"
    # playerctl uses OFFSET+ or OFFSET- for relative seeking
    # We convert standard +/-OFFSET to OFFSET+/-
    if [[ "$amount" =~ ^([+-])([0-9]+)$ ]]; then
        amount="${BASH_REMATCH[2]}${BASH_REMATCH[1]}"
    fi
    playerctl position "${amount}" 2>/dev/null
    sleep 0.15
    _quick_update_waybar
    pkill -RTMIN+11 waybar || true
}

do_repeat() {
    local current
    current=$(playerctl loop 2>/dev/null)
    local icon_dir="$HOME/.local/share/icons/mediactl"
    case "$current" in
        None)     playerctl loop Track 2>/dev/null;    notify-send -a "mediactl" -h string:x-canonical-private-synchronous:"$NOTIFY_TAG" -i "$icon_dir/repeat-track.png" "Repeat" "Track" ;;
        Track)    playerctl loop Playlist 2>/dev/null; notify-send -a "mediactl" -h string:x-canonical-private-synchronous:"$NOTIFY_TAG" -i "$icon_dir/repeat-playlist.png" "Repeat" "Playlist" ;;
        Playlist) playerctl loop None 2>/dev/null;     notify-send -a "mediactl" -h string:x-canonical-private-synchronous:"$NOTIFY_TAG" -i "$icon_dir/repeat-off.png" "Repeat" "Off" ;;
    esac
}

do_notify() {
    local status="${PLAYER_STATUS:-$(playerctl status 2>/dev/null)}"
    case "$status" in
        Playing) send_notification "$(get_song_display)" ;;
        Paused)  send_notification "$(get_song_display)" ;;
    esac
}

case "$1" in
    toggle)   do_toggle ;;
    next)     do_next ;;
    prev)     do_prev ;;
    stop)     do_stop ;;
    seek)     do_seek "$2" ;;
    repeat)   do_repeat ;;
    notify)   do_notify ;;
    restart)
        playerctl position 0 2>/dev/null
        send_notification "$(get_song_display)"
        ;;
    *)
        echo "Usage: mediactl {toggle|next|prev|stop|seek <+/-N>|repeat|restart|notify}"
        exit 1
        ;;
esac
