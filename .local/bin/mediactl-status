#!/usr/bin/env bash
# Author: Om Singh
# Waybar media module — outputs JSON for custom module

# Fetch metadata with a custom delimiter to handle multi-line fields and empty values robustly
data=$(playerctl -i Shazam metadata --format '{{status}}|{{title}}|{{artist}}|{{album}}|{{xesam:url}}|{{mpris:length}}|{{position}}' 2>/dev/null)

if [ -z "$data" ]; then
    echo '{"text": "", "class": "stopped", "tooltip": "No media playing"}'
    exit 0
fi

# Parse the piped data
IFS='|' read -r status title artist album url duration current_pos <<< "$data"

current_pos="${current_pos%.*}" # Handle floating point if any

if [ -z "$title" ]; then
    if [ -n "$url" ]; then
        file="${url#file://}"
        title="$(basename "$file")"
        title="$(echo -e "${title//%/\\x}")" # URL decode
    else
        title="Unknown"
    fi
fi

[ -z "$artist" ] && artist="Unknown Artist"
[ -z "$album" ] && album="Unknown Album"

# Escape Pango/XML special characters so & < > in metadata don't break Waybar rendering
pango_escape() {
    local s="$1"
    s="${s//&/&amp;}"
    s="${s//</&lt;}"
    s="${s//>/&gt;}"
    echo -n "$s"
}

# Build display from RAW (unescaped) text so truncation can't split Pango entities
display_raw="$title — $artist"

# Pre-truncate BEFORE Pango escaping to avoid cutting mid-entity (e.g. &amp; → &am)
max_len=30
truncated="false"
# Account for icon + space in length
if [ ${#display_raw} -gt $((max_len - 2)) ]; then
    max_display_len=$((max_len - 2))
    truncated_display="${display_raw:0:$max_display_len}"

    # Slice off characters from the end until we hit a space boundary
    if [[ "$truncated_display" == *" "* ]]; then
        display_raw="${truncated_display% *}"
    else
        display_raw="$truncated_display"
    fi

    # Strip any trailing hyphens, commas, or loose punctuation sitting at the cutoff
    display_raw=$(echo "$display_raw" | sed 's/[,;-]*$//')
    display_raw=$(echo "$display_raw" | sed 's/[[:space:]]*$//')

    truncated="true"
fi

# NOW Pango-escape everything
title=$(pango_escape "$title")
artist=$(pango_escape "$artist")
album=$(pango_escape "$album")
display=$(pango_escape "$display_raw")

# Resolve dynamic accent color from active wallust theme
accent_color="#8e6f65"
if [ -f "$HOME/.cache/wallust/colors-waybar.css" ]; then
    col=$(awk '/@define-color color2/ {gsub(/;/,"",$3); print $3; exit}' "$HOME/.cache/wallust/colors-waybar.css")
    [ -n "$col" ] && accent_color="$col"
fi

# Calculate playback percentage for Waybar tooltip
progress_str=""
percentage=0

if [ -n "$current_pos" ] && [ -n "$duration" ] && [ "$duration" -gt 0 ]; then
    # Simple percentage calculation: (pos * 100) / duration
    # This works regardless of whether units are seconds or microseconds,
    # as long as both use the same unit (which playerctl ensures).
    percentage=$(( current_pos * 100 / duration ))
    if [ "$percentage" -ge 0 ] && [ "$percentage" -le 100 ]; then
        progress_str=$'\n'"<span size='10000' color='${accent_color}'>Progress: ${percentage}%</span>"
    else
        percentage=0
    fi
fi

icon="󰎆"
[ "$status" = "Paused" ] && icon="󰏥"

full_text="$icon $display"

if [ "$percentage" -gt 0 ]; then
    # We want to format ONLY $display, not the icon
    len=${#display}

    prog_chars=$(( len * percentage / 100 ))
    if [ "$prog_chars" -gt 0 ]; then
        part1="${display:0:prog_chars}"
        part2="${display:prog_chars}"
        # Use a thicker, low-alpha background to look like a fill bar instead of just an underline.
        # Ensure it skips the leading icon.
        text="$icon <span bgalpha='30%' background='${accent_color}'>${part1}</span>${part2}"
    else
        text="$icon $display"
    fi
else
    text="$icon $display"
fi

tooltip=$(printf "<span size='12000' weight='bold'>%s</span>\n<span color='#cccccc'>%s</span>\n<span size='10000' color='#999999'><i>%s</i></span>%s" "$title" "$artist" "$album" "$progress_str")

# Escape variables for JSON
escape_json() {
    local str="$1"
    str="${str//\\/\\\\}" # backslash
    str="${str//\"/\\\"}" # double quote
    str="${str//$'\n'/\\n}" # newline
    str="${str//$'\t'/\\t}" # tab
    str="${str//$'\r'/\\r}" # carriage return
    echo -n "$str"
}

text_escaped=$(escape_json "$text")
tooltip_escaped=$(escape_json "$tooltip")

printf '{"text":"%s","class":"%s","tooltip":"%s","percentage":%d}\n' \
    "$text_escaped" "${status,,}" "$tooltip_escaped" "${percentage:-0}"
