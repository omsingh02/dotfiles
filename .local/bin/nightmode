#!/bin/sh
# Author: Om Singh
# Toggle blue light filter (wlsunset)
if pgrep -x wlsunset >/dev/null; then
    pkill wlsunset
    notify-send -a nightmode -h string:x-canonical-private-synchronous:nightmode "Night Mode" "Off"
else
    wlsunset -t 3500 -T 6500 &
    notify-send -a nightmode -h string:x-canonical-private-synchronous:nightmode "Night Mode" "On · 3500K"
fi
