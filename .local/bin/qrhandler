#!/bin/sh
# Author: Om Singh
# QR code encode/decode handler
# Usage: qrhandler encode|decode

case "$1" in
    encode)
        TEXT=$(wl-paste 2>/dev/null)
        [ -z "$TEXT" ] && TEXT=$(fuzzel -d -p "QR Text: " <<< "")
        [ -z "$TEXT" ] && exit 1
        qrencode -o "${XDG_RUNTIME_DIR:-/tmp/user-$(id -u)}/qr.png" -s 10 "$TEXT" && \
            mpv --no-terminal --force-window=yes --title="QR Code" \
                --geometry=400x400 --loop=inf "${XDG_RUNTIME_DIR:-/tmp/user-$(id -u)}/qr.png" &
        notify-send -a qrhandler "QR Encoded" "${TEXT:0:50}"
        ;;
    decode)
        grim -g "$(slurp)" "${XDG_RUNTIME_DIR:-/tmp/user-$(id -u)}/qr_scan.png" 2>/dev/null || exit 1
        RESULT=$(zbarimg -q --raw "${XDG_RUNTIME_DIR:-/tmp/user-$(id -u)}/qr_scan.png" 2>/dev/null)
        if [ -n "$RESULT" ]; then
            echo "$RESULT" | wl-copy
            notify-send -a qrhandler "QR Decoded" "$RESULT"
        else
            notify-send -a qrhandler -u critical "QR Decode" "No QR code found"
        fi
        ;;
    *)
        echo "Usage: qrhandler encode|decode"
        exit 1
        ;;
esac
