#!/bin/bash
# Author: Om Singh
# Screenshot utility — saves to ~/pix/ss/ AND copies to clipboard
# Usage: screenshot [full|region|ocr]

set -euo pipefail

SS_DIR="${SCREENSHOT_DIR:-$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots}"
mkdir -p "$SS_DIR"

case "${1:-full}" in
    full)
        FILE="$SS_DIR/ss-$(date +%Y%m%d-%H%M%S).png"
        grim "$FILE"
        wl-copy < "$FILE"
        notify-send -a screenshot -h string:x-canonical-private-synchronous:screenshot \
            -i camera-photo "Screenshot" "$(basename "$FILE")"
        ;;
    region)
        GEOM="$(slurp)" || exit 0
        FILE="$SS_DIR/ss-$(date +%Y%m%d-%H%M%S).png"
        grim -g "$GEOM" "$FILE"
        wl-copy < "$FILE"
        notify-send -a screenshot -h string:x-canonical-private-synchronous:screenshot \
            -i camera-photo "Region Capture" "$(basename "$FILE")"
        ;;
    ocr)
        GEOM="$(slurp)" || exit 0
        TMP=$(mktemp --suffix=.png)
        grim -g "$GEOM" "$TMP"
        TEXT=$(tesseract "$TMP" stdout 2>/dev/null)
        rm -f "$TMP"
        if [ -n "$TEXT" ]; then
            echo -n "$TEXT" | wl-copy
            notify-send -a screenshot -h string:x-canonical-private-synchronous:screenshot \
                "OCR" "$(echo "$TEXT" | head -2)"
        else
            notify-send -a screenshot -u critical "OCR" "No text detected"
        fi
        ;;
    *)
        echo "Usage: screenshot [full|region|ocr]"
        exit 1
        ;;
esac
