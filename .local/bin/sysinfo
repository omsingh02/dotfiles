#!/bin/sh
# Author: Om Singh
# System info popup via notification
BAT=$(cat /sys/class/power_supply/BAT1/capacity 2>/dev/null || echo "N/A")
BAT_STATUS=$(cat /sys/class/power_supply/BAT1/status 2>/dev/null || echo "N/A")
MEM=$(free -h | awk '/Mem/{print $3"/"$2}')
LOAD=$(cat /proc/loadavg | awk '{print $1, $2, $3}')
UPTIME=$(uptime -p | sed 's/up //')
DISK=$(df -h / | awk 'NR==2{print $3"/"$2" ("$5")"}')

# Show immediately with local data, fetch IP async
notify-send -a sysinfo -t 15000 \
    -h string:x-canonical-private-synchronous:sysinfo \
    "System" \
    "Load\t$LOAD
Mem\t$MEM
Disk\t$DISK
Bat\t${BAT}% · ${BAT_STATUS}
Up\t$UPTIME"

# Update with IP in background (non-blocking)
{
    IP=$(curl -s --max-time 3 ifconfig.me 2>/dev/null || echo "N/A")
    notify-send -a sysinfo -t 12000 \
        -h string:x-canonical-private-synchronous:sysinfo \
        "System" \
        "Load\t$LOAD
Mem\t$MEM
Disk\t$DISK
Bat\t${BAT}% · ${BAT_STATUS}
Up\t$UPTIME
IP\t$IP"
} &
