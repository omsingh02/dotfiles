#!/bin/sh
# Author: Om Singh
# System info popup via notification
BAT=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1)
BAT_STATUS=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null | head -1)
MEM=$(free -h | awk '/Mem/{print $3"/"$2}')
LOAD=$(cat /proc/loadavg | awk '{print $1, $2, $3}')
UPTIME=$(uptime -p | sed 's/up //')
IP=$(curl -s --max-time 3 ifconfig.me || echo "N/A")
DISK=$(df -h / | awk 'NR==2{print $3"/"$2" ("$5")"}')

notify-send -t 15000 "System Info" "\
CPU Load: $LOAD
Memory:   $MEM
Disk /:   $DISK
Battery:  ${BAT:-N/A}% (${BAT_STATUS:-N/A})
Uptime:   $UPTIME
Public IP: $IP"
