#!/usr/bin/env bash
# Author: Om Singh
# syspanel: Notification panel controller for mako & waybar

case "$1" in
    show|history|"")
        json=$(makoctl history -j 2>/dev/null)
        count=$(echo "$json" | jq '[.data[0][]? | .summary.data] | length' 2>/dev/null)

        if [[ -z "$count" || "$count" == "0" ]]; then
            notify-send -a syspanel -t 2000 \
                -h string:x-canonical-private-synchronous:syspanel \
                "Notifications" "No history"
        else
            body=$(echo "$json" | jq -r '
                [.data[0][]? |
                    "<b>\(.summary.data)</b>" +
                    (if .body.data != "" then "  <span alpha=\"60%\">\(.body.data[:80])</span>" else "" end) +
                    (if .["app-name"].data != "" then " <span alpha=\"40%\">· \(.["app-name"].data)</span>" else "" end)
                ] | join("\n")
            ' 2>/dev/null)
            notify-send -a syspanel -t 10000 \
                -h string:x-canonical-private-synchronous:syspanel \
                "Notifications ($count)" "$body"
        fi
        ;;

    clear)
        makoctl dismiss -a 2>/dev/null
        notify-send -a syspanel -t 1500 \
            -h string:x-canonical-private-synchronous:syspanel \
            "Notifications" "Cleared"
        ;;

    dnd-toggle|dnd)
        if makoctl mode | grep -q "do-not-disturb"; then
            makoctl mode -r do-not-disturb
            notify-send -a syspanel -t 2000 \
                -h string:x-canonical-private-synchronous:syspanel \
                "Notifications" "Do Not Disturb OFF"
        else
            makoctl mode -a do-not-disturb
        fi
        pkill -RTMIN+9 waybar 2>/dev/null || true
        ;;

    dnd-status)
        if makoctl mode | grep -q "do-not-disturb"; then
            echo '{"text": "󰂛", "class": "dnd-on", "tooltip": "Do Not Disturb"}'
        else
            echo '{"text": "󰂚", "class": "dnd-off", "tooltip": "Notifications"}'
        fi
        ;;

    *)
        echo "Usage: syspanel {show|clear|dnd-toggle|dnd-status}"
        exit 1
        ;;
esac
