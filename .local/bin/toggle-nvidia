#!/usr/bin/env bash
# toggle-nvidia: Toggle NVIDIA GPU environment variables in Hyprland config
# Usage: toggle-nvidia [on|off|status]
#   No args = toggle between on/off

set -euo pipefail

# ── Paths ──
ENV_CONF="$HOME/.config/hypr/conf/environment.conf"

# ── Helpers ──
log() { echo "✓ $*"; }
err() { echo "✗ ERROR: $*" >&2; }
die() { err "$*"; exit 1; }

# Check if NVIDIA vars are present in config
has_nvidia() {
    local file="$1"
    grep -q "LIBVA_DRIVER_NAME.*nvidia" "$file" 2>/dev/null || return 1
}

# Add NVIDIA vars to config
add_nvidia() {
    if [[ ! -f "$ENV_CONF" ]]; then
        die "Hyprland environment config not found: $ENV_CONF"
    fi
    
    if has_nvidia "$ENV_CONF"; then
        log "NVIDIA vars already in config"
        return 0
    fi
    
    # Add NVIDIA block at the beginning
    {
        echo "# NVIDIA GPU — Hardware acceleration and offload"
        echo "env = LIBVA_DRIVER_NAME,nvidia"
        echo "env = VDPAU_DRIVER,nvidia"
        echo "env = __GLX_VENDOR_LIBRARY_NAME,nvidia"
        echo "env = NVD_BACKEND,direct"
        echo "env = __NV_PRIME_RENDER_OFFLOAD,1"
        echo ""
        cat "$ENV_CONF"
    } > "$ENV_CONF.tmp" && mv "$ENV_CONF.tmp" "$ENV_CONF"
    log "Added NVIDIA vars to config"
}

# Remove NVIDIA vars from config
remove_nvidia() {
    if [[ ! -f "$ENV_CONF" ]]; then
        die "Hyprland environment config not found: $ENV_CONF"
    fi
    
    if ! has_nvidia "$ENV_CONF"; then
        log "NVIDIA vars not in config"
        return 0
    fi
    
    # Remove NVIDIA block and blank line after it (7 lines total: header + 5 vars + blank)
    sed -i '/^# NVIDIA GPU.*Hardware acceleration/,+6d' "$ENV_CONF"
    log "Removed NVIDIA vars from config"
}

# Check status
status() {
    echo "NVIDIA GPU Environment Variables Status:"
    echo "========================================="
    
    if has_nvidia "$ENV_CONF"; then
        echo "Status:   [ON]"
    else
        echo "Status:   [OFF]"
    fi
}

# Main
main() {
    local action="${1:-toggle}"
    
    case "$action" in
        on)
            add_nvidia
            echo ""
            status
            echo ""
            log "NVIDIA GPU support enabled"
            log "Reload Hyprland or restart session to apply changes"
            ;;
        off)
            remove_nvidia
            echo ""
            status
            echo ""
            log "NVIDIA GPU support disabled"
            log "Reload Hyprland or restart session to apply changes"
            ;;
        status)
            status
            ;;
        toggle)
            if has_nvidia "$ENV_CONF"; then
                main off
            else
                main on
            fi
            ;;
        *)
            echo "Usage: $0 [on|off|status]"
            echo "  No args = toggle between on/off"
            exit 1
            ;;
    esac
}

main "$@"
