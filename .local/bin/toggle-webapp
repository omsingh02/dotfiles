#!/bin/sh
# Author: Om Singh
# Toggle a web app in a Hyprland special workspace

WORKSPACE=$1
COMMAND=$2

# Check if any client exists in the specified special workspace
if hyprctl clients | grep -q "workspace: .* (special:$WORKSPACE)"; then
  # If the app is already running in the special workspace, just toggle the workspace visibility
  hyprctl dispatch togglespecialworkspace "$WORKSPACE"
else
  # If the app is not running, launch it into the special workspace
  hyprctl dispatch togglespecialworkspace "$WORKSPACE"
  hyprctl dispatch exec "[workspace special:$WORKSPACE] $COMMAND"
fi
