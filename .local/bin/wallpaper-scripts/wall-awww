#!/usr/bin/env bash
# Author: Om Singh
# wall-awww: Apply static wallpaper and update system colors via wallust
# Usage:
#   wall-awww /path/to/image.jpg
#   wall-awww /path/to/image.jpg --song
#   wall-awww /path/to/image.jpg --restore

set -euo pipefail

WALLPAPER="${1:-}"
MODE="${2:-normal}"

if [[ -z "$WALLPAPER" || ! -f "$WALLPAPER" ]]; then
    # Silent exit on restore if no wallpaper exists
    [[ "$MODE" == "--restore" ]] && exit 0
    echo "Usage: wall-awww /path/to/image.jpg [--song|--restore]"
    exit 1
fi

WALLPAPER="$(realpath "$WALLPAPER")"

# 1. Generate color palette via wallust
if ! wallust run -q "$WALLPAPER" 2>/dev/null; then
    echo "[$(date +'%H:%M:%S')] wall-awww: WARNING: wallust failed for $WALLPAPER" >&2
fi

# 2. Set wallpaper via awww with transition based on mode
transitions=("fade" "wipe")
if [[ "$MODE" == "--song" ]]; then
    transitions+=("grow")
fi

rand=$((RANDOM % ${#transitions[@]}))
trans="${transitions[$rand]}"

case "$trans" in
    fade)
        awww img "$WALLPAPER" --transition-type fade --transition-duration 2 >/dev/null 2>&1
        ;;
    wipe)
        awww img "$WALLPAPER" --transition-type wipe --transition-angle 30 --transition-step 90 --transition-duration 1 >/dev/null 2>&1
        ;;
    grow)
        awww img "$WALLPAPER" --transition-type grow --transition-pos 0.08,0.90 --transition-duration 1.5 >/dev/null 2>&1
        ;;
esac

# 3. Dynamic border updates
if [[ -f ~/.cache/wallust/colors-hyprland.conf ]]; then
    c2=$(grep "\$color2 =" ~/.cache/wallust/colors-hyprland.conf | cut -d' ' -f3-) || true
    c4=$(grep "\$color4 =" ~/.cache/wallust/colors-hyprland.conf | cut -d' ' -f3-) || true
    bg=$(grep "\$background =" ~/.cache/wallust/colors-hyprland.conf | cut -d' ' -f3-) || true
    
    hyprctl keyword general:col.active_border "$c2 $c4 45deg" 2>/dev/null || true
    hyprctl keyword general:col.inactive_border "$bg" 2>/dev/null || true
fi

# 4. Waybar auto-reloads via SIGUSR2 (hot reloads CSS and config)
killall -SIGUSR2 waybar || true
# 5. Rebuild mako config — inject colors into global scope (before any [section])
if [[ -f ~/.config/mako/config.base && -f ~/.cache/wallust/colors-mako ]]; then
    awk '/# WALLUST_COLORS_PLACEHOLDER/ { system("cat ~/.cache/wallust/colors-mako"); next } { print }' \
        ~/.config/mako/config.base > ~/.config/mako/config
    # Use setsid to completely detach mako if it needs to start
    makoctl reload 2>/dev/null || setsid mako >/dev/null 2>&1 &
fi

# 6. Rebuild foot config (write in-place to preserve inode for inotify hot-reload)
if [[ -f ~/.config/foot/foot.ini.base && -f ~/.cache/wallust/colors-foot.ini ]]; then
    cat ~/.config/foot/foot.ini.base ~/.cache/wallust/colors-foot.ini | tee ~/.config/foot/foot.ini >/dev/null
    # Broadcast OSC escape sequences to all active terminals so existing windows update immediately
    if [[ -f ~/.cache/wallust/sequences ]]; then
        for pt in /dev/pts/[0-9]*; do
            [[ -w "$pt" ]] && cat ~/.cache/wallust/sequences > "$pt" 2>/dev/null || true
        done
    fi
    killall -SIGUSR1 foot 2>/dev/null || true
fi

# 7. Update fuzzel colors (only if wallust generated the file)
if [[ -f ~/.cache/wallust/colors-fuzzel.ini ]]; then
    sed -i '/^\[colors\]/,$d' ~/.config/fuzzel/fuzzel.ini
    cat ~/.cache/wallust/colors-fuzzel.ini >> ~/.config/fuzzel/fuzzel.ini
fi

# 8. Btop theme is written directly by wallust template — no copy needed

# 9. Update GTK 3/4 colors
if [[ -f ~/.cache/wallust/colors-gtk.css ]]; then
    cp ~/.cache/wallust/colors-gtk.css ~/.config/gtk-3.0/gtk.css
    cp ~/.cache/wallust/colors-gtk.css ~/.config/gtk-4.0/gtk.css
fi

# 10. Update Qt5/Qt6 color scheme
if [[ -f ~/.cache/wallust/colors-qt.colors ]]; then
    mkdir -p ~/.config/qt5ct/colors ~/.config/qt6ct/colors
    cp ~/.cache/wallust/colors-qt.colors ~/.config/qt5ct/colors/wallust.colors
    cp ~/.cache/wallust/colors-qt.colors ~/.config/qt6ct/colors/wallust.colors
fi

# 11. Sync gsettings so xdg-desktop-portal-gtk serves correct theme to GTK apps
gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark' 2>/dev/null || true
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true

# 12. Keep ~/.cache/wal in sync for pywal/wal-theme compatibility
if [[ -f ~/.cache/wallust/colors && -f ~/.cache/wallust/colors.json ]]; then
    mkdir -p ~/.cache/wal
    cp -f ~/.cache/wallust/colors ~/.cache/wal/colors
    cp -f ~/.cache/wallust/colors.json ~/.cache/wal/colors.json
fi
