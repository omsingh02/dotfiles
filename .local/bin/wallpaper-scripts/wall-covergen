#!/usr/bin/env bash
# Author: Om Singh
# Generates a blurred background wallpaper with a crisp album cover
# Priority: local cover (if ≥400px) → iTunes HQ → playerctl fallback
# Caches finished wallpapers keyed by (title+artist+album+resolution+cover_hash)

if ! command -v playerctl &>/dev/null; then
    echo "Error: playerctl is not installed."
    exit 1
fi

urldecode() {
    local url_encoded="${1//+/ }"
    printf '%b' "${url_encoded//%/\\x}"
}

log() {
    echo "[$(date +'%H:%M:%S')] wall-covergen: $1" >&2
}

# --- Config ---
MIN_COVER_SIZE=400
MAX_CACHE_MB=500  # Evict oldest entries when cache exceeds this

CACHE_DIR="$HOME/.cache/cover-walls"
mkdir -p "$CACHE_DIR"

log "Fetching metadata from playerctl..."

TITLE="${PLAYER_TITLE:-$(playerctl -i Shazam metadata --format "{{ title }}" 2>/dev/null)}"
ARTIST="${PLAYER_ARTIST:-$(playerctl -i Shazam metadata --format "{{ artist }}" 2>/dev/null)}"
ART_URL="${PLAYER_ART_URL:-$(playerctl -i Shazam metadata mpris:artUrl 2>/dev/null)}"
ALBUM="${PLAYER_ALBUM:-$(playerctl -i Shazam metadata --format "{{ album }}" 2>/dev/null)}"

if [[ -z "$TITLE" ]]; then
    log "Error: No track is currently playing or no title found."
    exit 1
fi

log "Now Playing: $TITLE - $ARTIST [$ALBUM]"

OUTPUT="${1:-/tmp/cover_wallpaper.png}"

# --- Detect monitor resolution early (needed for cache key) ---
RES="1920x1080"
if command -v hyprctl &>/dev/null && command -v jq &>/dev/null; then
    HYPR_RES=$(hyprctl monitors -j | jq -r '.[0] | "\(.width)x\(.height)"' 2>/dev/null)
    [[ -n "$HYPR_RES" && "$HYPR_RES" != "nullxnull" ]] && RES="$HYPR_RES"
fi

# --- Resolve cover art first (needed for cache key) ---
TEMP_COVER=$(mktemp --suffix=.jpg)
# Clean up temp file on exit, but only if it's not being used as the final cover
trap '[[ "$COVER_PATH" != "$TEMP_COVER" ]] && rm -f "$TEMP_COVER"' EXIT
COVER_PATH=""

# 1. Try local cover from playerctl (mpd extracts embedded art to a file)
resolve_local_cover() {
    local art="$ART_URL"
    local path=""

    if [[ -z "$art" ]]; then
        return 1
    elif [[ "$art" == file://* ]]; then
        local raw="${art#file://}"
        path=$(urldecode "$raw")
    elif [[ "$art" != http://* && "$art" != https://* ]]; then
        path="$art"
    else
        # HTTP URL from playerctl — download it as a local candidate
        if curl -s --connect-timeout 3 --max-time 8 "$art" -o "$TEMP_COVER"; then
            path="$TEMP_COVER"
        else
            return 1
        fi
    fi

    if [[ -n "$path" && -f "$path" ]]; then
        # Check dimensions — usable if both sides are ≥ MIN_COVER_SIZE
        local dims
        dims=$(identify -format "%w %h" "$path" 2>/dev/null) || return 1
        local w h
        read -r w h <<< "$dims"
        if [[ "$w" -ge "$MIN_COVER_SIZE" && "$h" -ge "$MIN_COVER_SIZE" ]]; then
            COVER_PATH="$path"
            log "Local cover usable (${w}x${h})."
            return 0
        else
            log "Local cover too small (${w}x${h} < ${MIN_COVER_SIZE}px). Will try iTunes."
            return 1
        fi
    fi
    return 1
}

# 2. Try iTunes for a high-res cover
fetch_itunes_cover() {
    if ! command -v curl &>/dev/null || ! command -v jq &>/dev/null; then
        return 1
    fi

    log "Searching iTunes API for high-quality cover..."
    local search_term="${TITLE} ${ARTIST}"
    local itunes_data
    itunes_data=$(curl -s -G --connect-timeout 5 --max-time 10 \
        --data-urlencode "term=$search_term" \
        "https://itunes.apple.com/search?entity=song&limit=1") || return 1

    local low_res_url
    low_res_url=$(echo "$itunes_data" | jq -r '.results[0].artworkUrl100 // empty')

    if [[ -n "$low_res_url" ]]; then
        local high_res_url="${low_res_url/100x100bb/1000x1000bb}"
        log "iTunes high-res cover found. Downloading..."
        if curl -s --connect-timeout 5 --max-time 15 "$high_res_url" -o "$TEMP_COVER"; then
            COVER_PATH="$TEMP_COVER"
            return 0
        fi
    fi

    log "iTunes API returned no results."
    return 1
}

# 3. Last resort: use whatever playerctl gave us regardless of size
fallback_cover() {
    if [[ -z "$ART_URL" ]]; then
        return 1
    elif [[ "$ART_URL" == file://* ]]; then
        local raw="${ART_URL#file://}"
        COVER_PATH=$(urldecode "$raw")
    elif [[ "$ART_URL" == http://* || "$ART_URL" == https://* ]]; then
        curl -s --connect-timeout 5 --max-time 15 "$ART_URL" -o "$TEMP_COVER"
        COVER_PATH="$TEMP_COVER"
    else
        COVER_PATH="$ART_URL"
    fi

    [[ -f "$COVER_PATH" ]] && return 0
    return 1
}

# Run the priority chain
if ! resolve_local_cover; then
    if ! fetch_itunes_cover; then
        if ! fallback_cover; then
            log "Error: No album art found from any source."
            exit 1
        fi
        log "Using fallback cover (may be low-res)."
    fi
fi

if [[ ! -f "$COVER_PATH" ]]; then
    log "Error: Album cover file could not be read."
    exit 1
fi

# --- Cache key: includes title, artist, album, resolution, and cover content hash ---
# Cover content hash ensures cache invalidates when album art is re-tagged
COVER_HASH=$(md5sum "$COVER_PATH" | cut -d' ' -f1)
CACHE_KEY=$(echo -n "${TITLE}|${ARTIST}|${ALBUM}|${RES}|${COVER_HASH}" | md5sum | cut -d' ' -f1)
CACHED_WALL="$CACHE_DIR/${CACHE_KEY}.png"

if [[ -f "$CACHED_WALL" ]]; then
    # Validate the cached file is a real PNG (not a truncated/corrupt write)
    if identify "$CACHED_WALL" &>/dev/null; then
        log "Cache hit ($CACHE_KEY). Using cached wallpaper."
        # Touch to update mtime for LRU eviction
        touch "$CACHED_WALL"
        echo "$CACHED_WALL"
        exit 0
    else
        log "Cache corrupt ($CACHE_KEY). Regenerating."
        rm -f "$CACHED_WALL"
    fi
fi

log "Cache miss ($CACHE_KEY). Generating..."

# --- Evict old cache entries if over size limit ---
evict_cache() {
    local max_bytes=$(( MAX_CACHE_MB * 1024 * 1024 ))
    local cache_size
    cache_size=$(du -sb "$CACHE_DIR" 2>/dev/null | cut -f1)
    if [[ "$cache_size" -gt "$max_bytes" ]]; then
        log "Cache size (${cache_size} bytes) exceeds limit (${max_bytes}). Evicting oldest..."
        # Delete oldest-accessed files first (LRU by mtime since we touch on hit)
        ls -1t "$CACHE_DIR"/*.png 2>/dev/null | tail -n +$(( $(ls -1 "$CACHE_DIR"/*.png 2>/dev/null | wc -l) / 2 + 1 )) | xargs rm -f --
        log "Eviction complete. New size: $(du -sh "$CACHE_DIR" 2>/dev/null | cut -f1)"
    fi
}

evict_cache

# --- Generate wallpaper ---

# Find ImageMagick
if command -v magick &>/dev/null; then
    IM="magick"
elif command -v convert &>/dev/null; then
    IM="convert"
else
    echo "Error: ImageMagick is required."
    exit 1
fi

COVER_SIZE=650
RADIUS=16
FONT="/usr/share/fonts/CalSans-Regular.ttf"

log "Generating $RES wallpaper..."

$IM \
    \( "$COVER_PATH" -resize "${RES}^" -gravity center -extent "${RES}" -blur 0x80 -modulate 100,120 -fill black -colorize 30% \) \
    \( "$COVER_PATH" -resize "${COVER_SIZE}x${COVER_SIZE}^" -gravity center -extent "${COVER_SIZE}x${COVER_SIZE}" \
       \( -size "${COVER_SIZE}x${COVER_SIZE}" xc:none -fill white -draw "roundrectangle 0,0,${COVER_SIZE},${COVER_SIZE},${RADIUS},${RADIUS}" \) \
       -alpha Set -compose DstIn -composite \
       \( +clone -background black -shadow 40x40+0+30 \) \
       +swap -background none -compose over -layers merge +repage \) \
    -gravity center -compose over -composite \
    -gravity southwest -antialias \
    -font "$FONT" -pointsize 44 -fill "#ffffff" -annotate +80+72 "$TITLE" \
    -font "$FONT" -pointsize 18 -fill "rgba(255,255,255,0.6)" -annotate +80+50 "$ARTIST" \
    "$OUTPUT"

if [[ $? -eq 0 ]]; then
    # Atomic cache write: write to temp then rename so a kill mid-write
    # can never leave a corrupt file in the cache
    CACHE_TMP=$(mktemp -p "$CACHE_DIR" .tmp.XXXXXX.png)
    if cp "$OUTPUT" "$CACHE_TMP" && identify "$CACHE_TMP" &>/dev/null; then
        mv -f "$CACHE_TMP" "$CACHED_WALL"
        log "Successfully saved to: $OUTPUT (cached as $CACHE_KEY)"
    else
        rm -f "$CACHE_TMP"
        log "Successfully saved to: $OUTPUT (cache write failed, non-fatal)"
    fi
else
    log "Failed to generate wallpaper."
    exit 1
fi
