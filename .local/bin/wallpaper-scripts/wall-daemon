#!/usr/bin/env bash
# Author: Om Singh
# wall-daemon: Listens for media player events and updates wallpaper accordingly
# Relies on wall-core to apply song wallpapers or restore previous wallpapers

# Kill any existing instance via PID file
DAEMON_PID_FILE="/tmp/wall-daemon.pid"
if [[ -f "$DAEMON_PID_FILE" ]]; then
    OLD_PID=$(cat "$DAEMON_PID_FILE" 2>/dev/null)
    if [[ -n "$OLD_PID" ]] && [[ "$OLD_PID" != "$$" ]] && kill -0 "$OLD_PID" 2>/dev/null; then
        kill "$OLD_PID" 2>/dev/null || true
        sleep 0.5
    fi
fi
echo $$ > "$DAEMON_PID_FILE"

LOG_FILE="/tmp/medianotify.log"
echo "--- Daemon started at $(date) ---" > "$LOG_FILE"

log() {
    echo "[$(date +'%H:%M:%S')] wall-daemon: $1" >> "$LOG_FILE"
}

CURRENT_TITLE=""
LAST_NOTIFIED_TITLE=""
CURRENT_COVER=""

SCRIPT_DIR="$HOME/.local/bin/wallpaper-scripts"

# Cleanup on exit
trap 'log "Daemon exiting..."; kill $(jobs -p) 2>/dev/null' EXIT

playerctl --follow --ignore-player=mpv,vlc,Shazam metadata --format "{{playerName}}|{{status}}|{{title}}|{{artist}}|{{mpris:artUrl}}|{{xesam:url}}|{{album}}" |
while IFS='|' read -r player status title artist art_url url album; do

    # Skip if essentially empty
    [[ -z "$title" && -z "$artist" ]] && continue

    log "Event: $player | $status | $title | Album: [$album]"

    # Smart browser filter
    if [[ "$player" =~ (brave|chromium|firefox|chrome) ]]; then
        if [[ -z "$album" && "$art_url" != *"image/thumb"* && "$art_url" != *"scdn.co"* && "$url" != *"spotify"* && "$url" != *"youtube"* ]]; then
            log "Filtered: Generic web video detected"
            continue
        fi
    fi

    export PLAYER_STATUS="$status"
    export PLAYER_TITLE="$title"
    export PLAYER_ARTIST="$artist"
    export PLAYER_ART_URL="$art_url"
    export PLAYER_URL="$url"
    export PLAYER_ALBUM="$album"

    # Notification (Non-blocking) via mediactl
    if [[ "$status" == "Playing" && "$title" != "$LAST_NOTIFIED_TITLE" ]]; then
        (
            sleep 0.3
            mediactl notify
        ) &
        LAST_NOTIFIED_TITLE="$title"
    fi

    # Mode checks
    CURRENT_MODE="none"
    [[ -f "/tmp/wall_current_mode" ]] && CURRENT_MODE=$(cat /tmp/wall_current_mode)
    SONG_DISABLED=false
    if [[ -f "/tmp/disable_song_theme" ]]; then
        SONG_DISABLED=true
    fi

    # Theming logic
    if [[ "$status" == "Playing" ]]; then
        echo "playing" > /tmp/medianotify.state

        if [[ "$title" != "$CURRENT_TITLE" || "$CURRENT_MODE" != "song" ]]; then
            CURRENT_TITLE="$title"
            log "New track: $title. Starting background theming..."

            (
                "$SCRIPT_DIR/wall-song" >> "$LOG_FILE" 2>&1
            ) &
        fi
    elif [[ "$status" == "Stopped" || "$status" == "Paused" ]]; then
        if [[ "$CURRENT_MODE" == "song" && "$SONG_DISABLED" == "false" ]]; then
            echo "stopped" > /tmp/medianotify.state
            log "Playback $status. Scheduling restore..."
            (
                sleep 5
                [[ "$(cat /tmp/medianotify.state 2>/dev/null)" != "stopped" ]] && exit 0

                current_status=$(playerctl status 2>/dev/null)
                if [[ "$current_status" != "Playing" ]]; then
                    "$SCRIPT_DIR/wall-core" restore >> "$LOG_FILE" 2>&1
                    log "Wallpaper restored"
                fi
            ) &
            CURRENT_TITLE=""
        fi
    fi
done
