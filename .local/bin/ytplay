#!/bin/sh
# Author: Om Singh
# Play media URL from clipboard via mpv/yt-dlp
# Usage: ytplay [play|video|download]

URL=$(wl-paste 2>/dev/null)

# Validate URL
echo "$URL" | grep -qE '^https?://' || {
    notify-send -a ytplay -u critical "ytplay" "No valid URL in clipboard"
    exit 1
}

case "${1:-play}" in
    play)
        notify-send -a ytplay -h string:x-canonical-private-synchronous:ytplay "Playing" "${URL:0:60}"
        mpv --no-video --force-window=no "$URL"
        ;;
    video)
        notify-send -a ytplay -h string:x-canonical-private-synchronous:ytplay "Playing" "${URL:0:60}"
        mpv "$URL"
        ;;
    download)
        notify-send -a ytplay -h string:x-canonical-private-synchronous:ytplay "Downloading" "${URL:0:60}"
        yt-dlp -o ~/Videos/'%(title)s.%(ext)s' "$URL" && \
            notify-send -a ytplay "Download Complete" "${URL:0:60}" || \
            notify-send -a ytplay -u critical "Download Failed" "${URL:0:60}"
        ;;
    *)
        echo "Usage: ytplay [play|video|download]"
        exit 1
        ;;
esac
