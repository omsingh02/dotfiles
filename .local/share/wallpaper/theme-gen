def broadcast_sequences(sequences_file: Path) -> None:
    """Broadcasts ANSI escape sequences to all active /dev/pts/* terminals."""
    if not sequences_file.is_file():
        return
    seq_bytes = sequences_file.read_bytes()
    for pt in glob.glob("/dev/pts/[0-9]*"):
        try:
            if os.access(pt, os.W_OK):
                with open(pt, "wb", buffering=0) as f:
                    f.write(seq_bytes)
        except Exception:
            pass


def main():
    parser = argparse.ArgumentParser(description="Material You (HCT) Theming Engine")
    parser.add_argument("wallpaper", nargs="?", help="Path to wallpaper image")
    parser.add_argument("--mode", choices=["dark", "light", "toggle"], help="Color scheme mode (dark/light/toggle)")
    parser.add_argument("--variant", default=None, help="Scheme variant (tonalspot, expressive, vibrant, fidelity, fruitsalad, monochrome, neutral)")
    parser.add_argument("--flavour", default="default", choices=["default", "hard"], help="Surface flavour")
    parser.add_argument("--output-dir", default=str(THEME_DIR), help="Output directory for generated cache files")
    parser.add_argument("--dry-run", action="store_true", help="Print colors as JSON without writing files")
    parser.add_argument("--broadcast-only", action="store_true", help="Only broadcast OSC sequences to /dev/pts/*")

    args = parser.parse_args()

    out_dir = Path(args.output_dir)

    if args.broadcast_only:
        broadcast_sequences(out_dir / "sequences")
        return

    # Determine mode
    current_mode = get_current_mode()
    if args.mode == "toggle":
        target_mode = "light" if current_mode == "dark" else "dark"
        set_current_mode(target_mode)
    elif args.mode:
        target_mode = args.mode
        set_current_mode(target_mode)
    else:
        target_mode = current_mode

    # Determine variant
    current_variant = get_current_variant()
    if args.variant:
        target_variant = args.variant.lower()
        set_current_variant(target_variant)
    else:
        target_variant = current_variant

    # Resolve wallpaper path
    wallpaper_path = args.wallpaper
    if not wallpaper_path:
        if SAVED_STATIC_FILE.is_file():
            saved = SAVED_STATIC_FILE.read_text().strip()
            if os.path.isfile(saved):
                wallpaper_path = saved

    if not wallpaper_path or not os.path.isfile(wallpaper_path):
        print("Error: No valid wallpaper specified or found in cache.", file=sys.stderr)
        sys.exit(1)

    # 1. Score wallpaper to find primary HCT
    try:
        primary_hct = score(wallpaper_path)
    except Exception as e:
        print(f"Error scoring wallpaper: {e}", file=sys.stderr)
        sys.exit(1)

    # 2. Generate Material Schemes (Both Dark and Light for complete desktop sync)
    scheme_dark = SimpleNamespace(mode="dark", variant=target_variant, flavour=args.flavour)
    scheme_light = SimpleNamespace(mode="light", variant=target_variant, flavour=args.flavour)
    dark_colours = gen_scheme(scheme_dark, primary_hct)
    light_colours = gen_scheme(scheme_light, primary_hct)

    active_colours = light_colours if target_mode == "light" else dark_colours

    if args.dry_run:
        cmap = build_color_map(active_colours, target_mode == "light")
        print(json.dumps({"mode": target_mode, "variant": target_variant, "colors": cmap}, indent=2))
        return

    # 3. Generate all cache templates
    generate_all_files(active_colours, dark_colours, light_colours, target_mode == "light", out_dir)

    # 4. Broadcast OSC sequences to open terminals
    broadcast_sequences(out_dir / "sequences")

    print(f"Generated Material You ({target_mode.upper()} / {target_variant}) palette from {os.path.basename(wallpaper_path)}")


if __name__ == "__main__":
    main()
