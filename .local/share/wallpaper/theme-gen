def hex_to_ansi(hex_color: str, code: int, index: int | None = None) -> str:
    color = hex_color.lstrip("#")
    r, g, b = int(color[0:2], 16), int(color[2:4], 16), int(color[4:6], 16)
    if index is not None:
        return f"\033]{code};{index};rgb:{r:02x}/{g:02x}/{b:02x}\033\\"
    return f"\033]{code};rgb:{r:02x}/{g:02x}/{b:02x}\033\\"

def gen_sequences(colours: dict) -> str:
    seq = (
        hex_to_ansi(colours.get("onSurface", "ffffff"), 10)
        + hex_to_ansi(colours.get("surface", "000000"), 11)
        + hex_to_ansi(colours.get("secondary", "888888"), 12)
        + hex_to_ansi(colours.get("secondary", "888888"), 17)
    )
    for i in range(16):
        k = f"term{i}" if f"term{i}" in colours else f"color{i}"
        if k in colours:
            seq += hex_to_ansi(colours[k], 4, i)
    return seq

