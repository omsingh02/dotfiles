def hex_lighten(hex_str: str, amount: float) -> str:
    """Lightens a hex color by the specified fraction (0.0 - 1.0)."""
    hex_clean = hex_str.lstrip("#")
    r = int(hex_clean[0:2], 16)
    g = int(hex_clean[2:4], 16)
    b = int(hex_clean[4:6], 16)
    r = min(255, int(r + (255 - r) * amount))
    g = min(255, int(g + (255 - g) * amount))
    b = min(255, int(b + (255 - b) * amount))
    return f"{r:02X}{g:02X}{b:02X}"


def hex_darken(hex_str: str, amount: float) -> str:
    """Darkens a hex color by the specified fraction (0.0 - 1.0)."""
    hex_clean = hex_str.lstrip("#")
    r = int(hex_clean[0:2], 16)
    g = int(hex_clean[2:4], 16)
    b = int(hex_clean[4:6], 16)
    r = max(0, int(r * (1.0 - amount)))
    g = max(0, int(g * (1.0 - amount)))
    b = max(0, int(b * (1.0 - amount)))
    return f"{r:02X}{g:02X}{b:02X}"


def build_color_map(colours: dict[str, str], is_light: bool) -> dict[str, str]:
    """
    Builds a unified color mapping dictionary containing:
    - Wallust standard tokens (background, foreground, cursor, color0-color15)
    - Material 3 tokens (surface, onSurface, primary, secondary, error, etc.)
    """
    surface = colours.get("surface", "121416" if not is_light else "F8F9FD").upper()
    on_surface = colours.get("onSurface", "E9ECEC" if not is_light else "191C1E").upper()
    primary = colours.get("primary", "AACAE9" if not is_light else "376386").upper()
    on_primary = colours.get("onPrimary", "12334F" if not is_light else "FFFFFF").upper()
    primary_container = colours.get("primaryContainer", "2E4A6B" if not is_light else "D1E4FF").upper()
    on_primary_container = colours.get("onPrimaryContainer", "D1E4FF" if not is_light else "001D36").upper()
    secondary = colours.get("secondary", "BDC7D5" if not is_light else "526070").upper()
    on_secondary = colours.get("onSecondary", "27313C" if not is_light else "FFFFFF").upper()
    secondary_container = colours.get("secondaryContainer", "3D4753" if not is_light else "D6E4F7").upper()
    on_secondary_container = colours.get("onSecondaryContainer", "D6E4F7" if not is_light else "0F1D2A").upper()
    tertiary = colours.get("tertiary", "D4BFE6" if not is_light else "6B5778").upper()
    surface_container = colours.get("surfaceContainer", "1C1F23" if not is_light else "EDEEF2").upper()
    surface_container_high = colours.get("surfaceContainerHigh", "27292E" if not is_light else "E7E8EC").upper()
    surface_container_low = colours.get("surfaceContainerLow", "17191C" if not is_light else "F3F3F7").upper()
    surface_variant = colours.get("surfaceVariant", "42474E" if not is_light else "DEE3EB").upper()
    on_surface_variant = colours.get("onSurfaceVariant", "C2C7CF" if not is_light else "42474E").upper()
    outline = colours.get("outline", "8C9199" if not is_light else "73777F").upper()
    outline_variant = colours.get("outlineVariant", "42474E" if not is_light else "C2C7CF").upper()
    error = colours.get("error", "FFB4AB" if not is_light else "BA1A1A").upper()
    on_error = colours.get("onError", "690005" if not is_light else "FFFFFF").upper()

    mapping = {
        "background": surface,
        "foreground": on_surface,
        "cursor": primary,
        "surface": surface,
        "onSurface": on_surface,
        "primary": primary,
        "onPrimary": on_primary,
        "primaryContainer": primary_container,
        "onPrimaryContainer": on_primary_container,
        "secondary": secondary,
        "onSecondary": on_secondary,
        "secondaryContainer": secondary_container,
        "onSecondaryContainer": on_secondary_container,
        "tertiary": tertiary,
        "surfaceContainer": surface_container,
        "surfaceContainerHigh": surface_container_high,
        "surfaceContainerLow": surface_container_low,
        "surfaceVariant": surface_variant,
        "onSurfaceVariant": on_surface_variant,
        "outline": outline,
        "outlineVariant": outline_variant,
        "error": error,
        "onError": on_error,
    }

    for i in range(16):
        term_key = f"term{i}"
        val = colours.get(term_key)
        if not val:
            val = surface if i == 0 else (on_surface if i == 15 else primary)
        mapping[f"color{i}"] = val.upper()

    return mapping


def render_template_string(template_text: str, cmap: dict[str, str]) -> str:
    def replacer(match):
        expr = match.group(1).strip()
        parts = [p.strip() for p in expr.split("|")]
        var_name = parts[0]
        val = cmap.get(var_name, "FFFFFF")

        strip_hash = False
        for filter_part in parts[1:]:
            filter_part = filter_part.strip()
            if filter_part == "strip":
                strip_hash = True
            elif filter_part.startswith("lighten(") and filter_part.endswith(")"):
                try:
                    amt = float(filter_part[8:-1])
                    val = hex_lighten(val, amt)
                except ValueError:
                    pass
            elif filter_part.startswith("darken(") and filter_part.endswith(")"):
                try:
                    amt = float(filter_part[7:-1])
                    val = hex_darken(val, amt)
                except ValueError:
                    pass

        val_clean = val.lstrip("#")
        return val_clean if strip_hash else f"#{val_clean}"

    pattern = re.compile(r"\{\{([^}]+)\}\}")
    return pattern.sub(replacer, template_text)


def sync_antigravity_theme(out_dir: Path) -> None:
    """Directly compiles and writes the active theme into Antigravity IDE extension for instant live update."""
    if not ANTIGRAVITY_THEME_DIR.is_dir():
        return
    node_script = f"""
const Color = require('{ANTIGRAVITY_THEME_DIR}/node_modules/color');
const template = require('{ANTIGRAVITY_THEME_DIR}/out/template').default;
const fs = require('fs');
const path = require('path');

try {{
    const themesDir = '{ANTIGRAVITY_THEME_DIR}/themes';
    const colorsData = fs.readFileSync('{out_dir}/colors', 'utf-8');
    const colorStrings = colorsData.trim().split(/\\s+/).filter(s => s.length > 0).map(c => c.startsWith('#') ? c : '#' + c);
    const colors = colorStrings.map(c => Color(c));

    if (fs.existsSync('{out_dir}/colors.json')) {{
        try {{
            const jsonColors = JSON.parse(fs.readFileSync('{out_dir}/colors.json', 'utf-8'));
            if (jsonColors.special?.background) colors[0] = Color(jsonColors.special.background);
            if (jsonColors.special?.foreground) colors[7] = Color(jsonColors.special.foreground);
        }} catch (e) {{}}
    }}

    const themeNormal = template(colors, false);
    const themeBordered = template(colors, true);

    fs.writeFileSync(path.join(themesDir, 'wallust.json'), JSON.stringify(themeNormal, null, 4));
    fs.writeFileSync(path.join(themesDir, 'wallust-bordered.json'), JSON.stringify(themeBordered, null, 4));
}} catch (err) {{
    // non-fatal
}}
"""
    try:
        subprocess.run(["node", "-e", node_script], check=False, timeout=3)
    except Exception:
        pass


