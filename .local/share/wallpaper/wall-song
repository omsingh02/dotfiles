#!/usr/bin/env bash
# Author: Om Singh
# wall-song: Generates an album art wallpaper and applies it via wall-core
# Normally called by wall-daemon. Relies on PLAYER_TITLE, PLAYER_ARTIST, etc from environment.

set -euo pipefail

# Ensure PATH is correct (specifically for wallpaper-scripts)
source "$HOME/.config/shell/env.sh"

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
STATE_DIR="/tmp"
SONG_DISABLE_FILE="$STATE_DIR/disable_song_theme"
RECHECK_FILE="$STATE_DIR/medianotify.recheck"
LOG_FILE="$STATE_DIR/medianotify.log"

log() {
    echo "[$(date +'%H:%M:%S')] wall-song: $1" >> "$LOG_FILE"
}

if [[ -f "$SONG_DISABLE_FILE" ]]; then
    log "Song mode disabled. Exiting silently."
    exit 0
fi

# Use a lock to prevent overlapping runs when skipping tracks rapidly
exec 9>"$STATE_DIR/medianotify.lock"
if ! flock -n 9; then
    # Don't silently drop — mark that a recheck is needed when current run finishes
    touch "$RECHECK_FILE"
    log "Theming in progress. Marked for recheck."
    exit 0
fi

# Clear any pending recheck since we're about to process
rm -f "$RECHECK_FILE"

# Re-read current metadata from playerctl so we always theme the CURRENT
# track, not whatever was playing when wall-daemon originally spawned us
PLAYER_TITLE="$(playerctl -i Shazam,playerctld metadata --format '{{ title }}' 2>/dev/null || true)"
PLAYER_ARTIST="$(playerctl -i Shazam,playerctld metadata --format '{{ artist }}' 2>/dev/null || true)"
PLAYER_ART_URL="$(playerctl -i Shazam,playerctld metadata mpris:artUrl 2>/dev/null || true)"
export PLAYER_TITLE PLAYER_ARTIST PLAYER_ART_URL

if [[ -z "$PLAYER_TITLE" ]]; then
    log "No track playing. Nothing to theme."
    exit 0
fi

log "Theming: $PLAYER_TITLE - $PLAYER_ARTIST"

NEW_COVER=$(mktemp --suffix=.png)

# Temporarily disable set -e so we can capture the exit code properly.
set +e
RESULT=$("$SCRIPT_DIR/wall-covergen" "$NEW_COVER" 2>> "$LOG_FILE")
GEN_RC=$?
set -e

if [[ $GEN_RC -eq 0 ]]; then
    # If gen-cover-wall returned a cached path, use that instead of the temp file
    if [[ -n "$RESULT" && -f "$RESULT" ]]; then
        rm -f "$NEW_COVER"
        NEW_COVER="$RESULT"
    fi
    log "Cover ready: $NEW_COVER. Setting via wall-core."
    "$SCRIPT_DIR/wall-core" set song "$NEW_COVER" 9>&- >> "$LOG_FILE" 2>&1
else
    log "Failed to generate cover for ${PLAYER_TITLE:-Unknown} (exit code: $GEN_RC)"
    rm -f "$NEW_COVER"
    exit 1
fi

# After finishing, check if another song change happened while we were busy.
# If so, re-trigger to process the latest track.
if [[ -f "$RECHECK_FILE" ]]; then
    rm -f "$RECHECK_FILE"
    CURRENT_TITLE="$(playerctl -i Shazam,playerctld metadata --format '{{ title }}' 2>/dev/null || true)"
    if [[ -n "$CURRENT_TITLE" && "$CURRENT_TITLE" != "$PLAYER_TITLE" ]]; then
        log "Track changed during processing ($PLAYER_TITLE → $CURRENT_TITLE). Re-triggering."
        exec "$0"
    else
        log "Recheck requested but track unchanged. Done."
    fi
fi
